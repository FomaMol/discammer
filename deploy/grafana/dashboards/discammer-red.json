{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "title": "DiScammer — RED",
  "tags": ["discammer", "red"],
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by status class (req/s, 5m)",
      "description": "Sampled across 2 workers — treat as directional (see docs/ops/monitoring.md).",
      "datasource": { "type": "prometheus", "uid": "discammer-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "discammer-prom" },
          "expr": "sum(rate(discammer_requests_total[5m])) by (status_class)",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx error rate (share of requests, 5m)",
      "datasource": { "type": "prometheus", "uid": "discammer-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "discammer-prom" },
          "expr": "sum(rate(discammer_errors_total[5m])) / clamp_min(sum(rate(discammer_requests_total[5m])), 1e-9)",
          "legendFormat": "5xx share"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request duration p50 / p95 / p99 (5m)",
      "datasource": { "type": "prometheus", "uid": "discammer-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "discammer-prom" },
          "expr": "histogram_quantile(0.50, sum(rate(discammer_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "discammer-prom" },
          "expr": "histogram_quantile(0.95, sum(rate(discammer_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "discammer-prom" },
          "expr": "histogram_quantile(0.99, sum(rate(discammer_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Surface views by surface (AN-1, 5m)",
      "datasource": { "type": "prometheus", "uid": "discammer-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "discammer-prom" },
          "expr": "sum(rate(discammer_surface_views_total[5m])) by (surface)",
          "legendFormat": "{{surface}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Deployed build",
      "description": "OBS-1 build_info — correlate error spikes with the release.",
      "datasource": { "type": "prometheus", "uid": "discammer-prom" },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 16 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^git_sha$/" }, "textMode": "name" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "discammer-prom" },
          "expr": "discammer_build_info",
          "legendFormat": "{{version}} @ {{git_sha}}",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error events by source/kind (OBS-1, 5m)",
      "datasource": { "type": "prometheus", "uid": "discammer-prom" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "discammer-prom" },
          "expr": "sum(rate(discammer_error_events_total[5m])) by (source, kind)",
          "legendFormat": "{{source}}/{{kind}}"
        }
      ]
    }
  ]
}
