[Unit]
Description=DiScammer on verified persistent data
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/opt/discammer

[Service]
Type=simple
EnvironmentFile=/etc/discammer/deployment.env
ExecStart=/etc/discammer/start-guard.sh
ExecStop=/usr/bin/docker compose -f /etc/discammer/compose.yaml stop -t 30
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
